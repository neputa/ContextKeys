{
  "manifest_version": 2,
  "name": "ContextKeys",
  "description": "Thunderbird の現在のメッセージ一覧コンテキストで使えるショートカットを表示します。",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "contextkeys@local.dev",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "ContextKeys",
    "default_popup": "shortcut-dialog.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "windows"
  ],
  "commands": {
    "show-shortcuts": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Show shortcut list for the current context"
    }
  }
}
