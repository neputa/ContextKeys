{
  "manifest_version": 2,
  "name": "ContextKeys",
  "description": "Thunderbird の現在のメッセージ一覧コンテキストで使えるショートカットを表示します。",
  "version": "1.0.1",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "contextkeys@local.dev",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "commands": {
    "show-shortcuts": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Show shortcut list for the current context"
    }
  }
}
